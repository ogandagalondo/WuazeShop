# =================================================================
# WUAZESHOP — VARIABLES D'ENVIRONNEMENT DE PRODUCTION (.env)
# =================================================================
# Ce fichier sert de modèle. Copiez ce fichier sous le nom ".env" 
# et renseignez vos informations personnelles réelles.
# Attention : Le fichier ".env" est ignoré par Git et ne doit JAMAIS être partagé.

# 1. Configuration Réseau & Serveur
PORT=3000
NODE_ENV=development

# 2. Sécurité Cryptographique (Générez une chaîne aléatoire de 64 caractères)
JWT_SECRET=votre-cle-secrete-tres-longue-et-aleatoire-wuazeshop-gabon-2026

# 3. Identifiants Personnels du Super Administrateur (Fondateur)
# Ces identifiants écrasent les valeurs par défaut dès le démarrage du serveur !
ADMIN_FULL_NAME="Votre Prénom et Nom"
ADMIN_USERNAME=votre_pseudo
ADMIN_EMAIL=votre.email@domaine.com
ADMIN_PASSWORD=VotreMotDePasseUltraSecurise2026!

# 4. Passerelle de Paiement
# Utilisez 'SIMULATOR' en local/test, ou le nom de votre agrégateur en production
PAYMENT_GATEWAY=SIMULATOR
ENABLE_PAYMENT_SIMULATOR=false

# 5. Base de données
DB_PATH=wuazeshop.db
